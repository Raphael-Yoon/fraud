		<Compiler>
			<Add option="-Wall" />
			<Add option="-std=c++17" />
			<Add option="-DUNICODE" />
			<Add option="-D_UNICODE" />
		</Compiler>
		<Linker>
			<Add option="-static-libgcc" />
			<Add option="-static-libstdc++" />
